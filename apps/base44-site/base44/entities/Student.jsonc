{
  "name": "Student",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Verified Base44 user ID; only the owning account can access this workspace"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "access_code": {
      "type": "string"
    },
    "certificate_status": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "issued"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "not_requested"
    },
    "certificate_code": {
      "type": "string"
    },
    "requested_date": {
      "type": "string"
    },
    "issued_date": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "access_code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}