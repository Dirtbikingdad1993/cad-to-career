{
  "name": "ReviewerSetting",
  "type": "object",
  "properties": {
    "passcode_hash": {
      "type": "string"
    },
    "salt": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "claim_date": {
      "type": "string"
    }
  },
  "required": [
    "passcode_hash",
    "salt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}